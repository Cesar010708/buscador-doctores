# Buscador de Doctores — variables de entorno
# Copia este archivo como `.env` y rellena los valores. `.env` nunca se versiona.
# Todos los valores de aquí son de ejemplo.

# ── Base de datos (MariaDB / MySQL) ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=buscador_doctores
DB_USER=buscador
DB_PASS=cambia-esta-contrasena

# Prefijo de las tablas: `bd_demo_` para la demo con datos ficticios, `bd_` para
# las definitivas. Solo [a-z0-9_], empezando por letra.
BD_PREFIJO=bd_demo_

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Con BD_IA_ACTIVA=0 el buscador funciona completo sin IA (justificaciones de
# plantilla) y no hace falta clave.
OPENAI_API_KEY=sk-tu-clave-de-openai
OPENAI_CHAT_MODEL=gpt-4o-mini
BD_IA_ACTIVA=1

# ── Web ─────────────────────────────────────────────────────────────────────
# Origen desde el que se sirven las páginas (CORS con cookie de sesión).
BD_ORIGIN=http://127.0.0.1:8085
APP_TIMEZONE=America/Mexico_City

# Sal para hashear la IP en la bitácora de búsquedas: una cadena larga y aleatoria.
BD_IP_SALT=cambia-esto-por-una-cadena-larga-y-aleatoria

# ── Límites (opcionales; estos son los valores por defecto) ─────────────────
BUSCAR_RATE_MAX=20
BUSCAR_RATE_WINDOW=60
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW=60
GUARDAR_RATE_MAX=30
GUARDAR_RATE_WINDOW=60
# Tamaño máximo de la cédula subida, en bytes (5 MB)
BD_UPLOAD_MAX=5242880
